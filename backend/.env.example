# Bonafide backend — environment for local runs (all public values, no secrets)
# The app loads these from the shell:  export $(cat .env.example | xargs)
GOOGLE_CLOUD_PROJECT=bonafide-cup-2026
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
BONAFIDE_REGION=asia-southeast1
BONAFIDE_BUCKET=bonafide-cup-2026.firebasestorage.app
BONAFIDE_MODEL_MAIN=gemini-3.8-flash
BONAFIDE_MODEL_SMALL=gemini-3.5-flash-lite
BONAFIDE_EMBED_MODEL=gemini-embedding-2
BONAFIDE_MODEL_ARMOR_TEMPLATE=bonafide-input
BONAFIDE_GROUNDING_MIN=0.6
BONAFIDE_DEMO_MODE=true
BONAFIDE_SERVICE_URL=https://bonafide-api-199277557753.asia-southeast1.run.app
BONAFIDE_SCHEDULER_SA=bonafide-scheduler@bonafide-cup-2026.iam.gserviceaccount.com
